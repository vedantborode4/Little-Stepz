# apps/crm-api/.env on the VPS. Never commit the real file.
NODE_ENV=production
PORT=8100
HOST=127.0.0.1

# crm-postgres on the same host (docker/crm-postgres.compose.yml). Same value in packages/crm-db/.env.
CRM_DATABASE_URL=postgresql://crm:<CRM_DB_PASSWORD>@127.0.0.1:5433/littlestepz_crm?schema=public&connection_limit=10

CORS_ORIGIN=https://crm.littlestepz.in
# openssl rand -base64 48
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
BCRYPT_ROUNDS=12

# Behind nginx over HTTPS
COOKIE_SECURE=true
TRUST_PROXY_HOPS=1
LOG_LEVEL=info

# Read-only website pull. Leave off until the website's export endpoints exist
# (docs/crm/WEBSITE_SYNC_CONTRACT.md). "mock" is refused in production.
WEBSITE_SYNC_MODE=off
WEBSITE_SYNC_URL=
WEBSITE_SYNC_KEY=

# First run only: `pnpm --filter crm-api seed` creates the owner login, then blank these.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DEMO_USERS=false

# Product photo uploads (Cloudinary). Leave blank to turn uploads off; photo links still work.
# The website's account can be reused: the CRM only uploads to, and deletes from, CLOUDINARY_FOLDER.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=littlestepz-crm
