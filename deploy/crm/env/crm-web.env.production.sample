# apps/crm-web/.env.production on the VPS (read by `next build` and `next start`).
# Server-side only: where the web app proxies /api/* when nginx doesn't (nginx sends /api/ straight to crm-api).
CRM_API_ORIGIN=http://127.0.0.1:8100
# false hides the SAMPLE DATA banner; only once demo data is gone.
NEXT_PUBLIC_DEMO_MODE=false
