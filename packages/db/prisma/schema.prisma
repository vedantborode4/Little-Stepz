generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  AFFILIATE
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String?
  name         String
  phone        String?
  role         Role     @default(USER)

  googleId      String?  @unique
  appleId       String?  @unique
  avatarUrl     String?
  emailVerified Boolean  @default(false)

  referralCode String?  @unique
  referredById String?
  referredBy   User?    @relation("UserReferrals", fields: [referredById], references: [id])
  referrals    User[]   @relation("UserReferrals")

  addresses     Address[]
  cartItems     CartItem[]
  wishlistItem  WishlistItem[]
  orders        Order[]
  reviews       Review[]
  affiliate     Affiliate?
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  preOrders     PreOrder[]

  passwordResetTokens PasswordResetToken[]

  verifiedPhones     VerifiedPhone[]
  phoneOtpChallenges PhoneOtpChallenge[]

  deviceTokens           DeviceToken[]
  notifications          Notification[]
  notificationPreference NotificationPreference?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([role])
  @@index([referralCode])
}

model RefreshToken {
  id                String   @id @default(uuid())
  tokenHash         String   @unique
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt         DateTime
  revoked           Boolean  @default(false)

  replacedByTokenId String?
  replacedByToken   RefreshToken? @relation("TokenRotation", fields: [replacedByTokenId], references: [id])
  replacedTokens    RefreshToken[] @relation("TokenRotation")

  deviceId          String?
  ipAddress         String?
  userAgent         String?

  createdAt DateTime @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  codeHash  String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int      @default(0)

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// A signup that has been submitted but whose email has not been proven yet.
///
/// No `User` row exists until the emailed code is redeemed, so an address that can't
/// receive mail never reaches the User table. Rows are short-lived: a new request for
/// the same email supersedes the outstanding one, success deletes the row inside the
/// same transaction that creates the User, and the auth sweeper reaps the rest.
model PendingSignup {
  id String @id @default(uuid())

  /// Unique so a repeat request is a single upsert rather than delete-and-recreate,
  /// which also bounds row growth per address and gives resend counters a home.
  email        String  @unique
  name         String
  phone        String?
  /// bcrypt hash at the same cost as User.password — copied verbatim on create and
  /// never re-hashed. Never returned by any endpoint.
  passwordHash String
  /// Raw code as typed; resolved to a referrer only at verify time.
  referralCode String?

  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)

  /// Cross-instance resend control. The IP rate limiters are per-process and
  /// in-memory, so these two columns are the only guard that survives scaling.
  sendCount  Int      @default(1)
  lastSentAt DateTime @default(now())

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// A phone number this user has proved control of.
///
/// Keyed on (user, phone) rather than a boolean on `Address` because
/// `updateAddressService` retires the address row and creates a new one whenever an
/// Order or PreOrder references it — a per-address flag would reset to false when a
/// customer edited their *city*, charging for another SMS on an edit that never
/// touched the phone. Users also routinely share one number across several
/// addresses. Verification is a property of (person, number), which is what this is.
model VerifiedPhone {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Bare 10 digits — the invariant `phoneSchema` holds on every write path, so
  /// lookups need no normalisation.
  phone      String
  verifiedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([userId, phone])
  @@index([phone])
}

/// An in-flight phone OTP.
///
/// No `tokenHash` twin of PasswordResetToken: that needs an opaque token because the
/// reset link is redeemed unauthenticated, whereas here the caller is already behind
/// authMiddleware and (userId, phone) identifies the challenge.
model PhoneOtpChallenge {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  phone     String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)

  /// SMS costs money, unlike email — these bound the spend across instances, which
  /// the in-memory IP limiters cannot.
  sendCount  Int      @default(1)
  lastSentAt DateTime @default(now())

  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, phone])
  @@index([phone, createdAt])
  @@index([userId, createdAt])
  @@index([expiresAt])
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  name      String
  phone     String
  address   String
  city      String
  state     String
  pincode   String
  country   String  @default("India")
  isDefault Boolean @default(false)

  orders    Order[]
  preOrders PreOrder[]

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  image       String?

  // SEO overrides (admin SEO panel) — fall back to generated metadata when null.
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  noindex         Boolean @default(false)

  parentId    String?
  isActive    Boolean  @default(true)

  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PriceDisplay {
  BOTH
  REGULAR
  SALE
}

model Product {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  longDescription String?
  price        Decimal      @db.Decimal(12,2)
  salePrice    Decimal?     @db.Decimal(12,2)
  costPrice    Decimal?     @db.Decimal(12,2) // purchase cost per unit — used for exact P&L; falls back to an estimate when null
  isOnSale     Boolean      @default(false)
  priceDisplay PriceDisplay @default(BOTH)
  /// The price a customer actually pays: salePrice when on sale, else price.
  /// Kept in sync by a Postgres trigger (see the effective_price_via_trigger
  /// migration) — READ ONLY, never write to it. Exists so "sort by price" and the
  /// min/max price filter can be indexed SQL instead of an in-memory sort.
  effectivePrice Decimal?   @db.Decimal(12,2)
  quantity    Int      @default(0)
  inStock     Boolean  @default(true)
  categoryId  String

  specifications Json?

  // SEO overrides (admin SEO panel) — fall back to generated metadata when null.
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  noindex         Boolean @default(false)

  // Merchant / product identity (Google Shopping feed + Product JSON-LD).
  brand     String?
  gtin      String?
  mpn       String?
  condition String? @default("new")

  preOrderEnabled Boolean  @default(false)
  bookingAmount   Decimal? @db.Decimal(12,2)
  preOrderLimit   Int?
  preOrderCount   Int      @default(0)
  preOrderNote    String?

  /// Partial payment (20% deposit / balance at delivery). Default false: a new payment
  /// term is opted into per product, never applied to the whole catalogue by a migration.
  /// `depositPercent` null inherits PARTIAL_PAYMENT_PERCENT.
  partialPaymentEnabled Boolean  @default(false)
  depositPercent        Decimal? @db.Decimal(5,2)

  category     Category      @relation(fields: [categoryId], references: [id])
  images       ProductImage[]
  variants     Variant[]
  options      ProductOption[]
  cartItems    CartItem[]
  wishlistItem WishlistItem[]
  orderItems   OrderItem[]
  reviews      Review[]
  preOrders    PreOrder[]

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([categoryId])
  @@index([deletedAt])
  @@index([effectivePrice])
}

model ProductImage {
  id        String @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId String?
  variant   Variant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  url       String
  publicId  String
  alt       String?
  sortOrder Int @default(0)

  deletedAt DateTime?

  createdAt DateTime @default(now())

  @@index([variantId])
}

model Variant {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  name      String
  sku       String?  @unique
  sortOrder Int      @default(0)
  isDefault Boolean  @default(false)
  price     Decimal? @db.Decimal(12,2)
  salePrice Decimal? @db.Decimal(12,2)
  isOnSale  Boolean  @default(false)
  stock     Int      @default(0)

  /// Per-variant pre-order terms. The product-level switch is the master: a variant
  /// can only opt OUT of pre-orders, never opt in while the product has them off.
  /// Defaults to true so existing variants keep inheriting the product's setting.
  preOrderEnabled Boolean  @default(true)
  /// Null inherits Product.bookingAmount — mirrors how `price` overrides work.
  bookingAmount   Decimal? @db.Decimal(12,2)
  /// Optional cap for this variant alone. The product cap still applies as the
  /// total across every variant, so both are checked.
  preOrderLimit   Int?
  preOrderCount   Int      @default(0)

  /// Per-variant partial-payment terms, following the pre-order rule exactly: the product
  /// switch is master, so a variant can only opt OUT. Defaults true to inherit.
  partialPaymentEnabled Boolean  @default(true)
  /// Null inherits Product.depositPercent, which in turn inherits the env default.
  depositPercent        Decimal? @db.Decimal(5,2)

  cartItems    CartItem[]
  orderItems   OrderItem[]
  images       ProductImage[]
  preOrders    PreOrder[]
  optionValues VariantOptionValue[]

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Active-name uniqueness is enforced by a partial unique index (see the
  // structured_variants migration) so a soft-deleted name can be reused.
  @@index([productId])
}

model ProductOption {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  name      String
  sortOrder Int      @default(0)

  values    ProductOptionValue[]

  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, name])
  @@index([productId])
}

model ProductOptionValue {
  id        String   @id @default(uuid())
  optionId  String
  option    ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  value     String
  swatchHex String?
  sortOrder Int      @default(0)

  variantLinks VariantOptionValue[]

  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([optionId, value])
  @@index([optionId])
}

model VariantOptionValue {
  id            String @id @default(uuid())
  variantId     String
  variant       Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValueId String
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([variantId, optionValueId])
  @@index([variantId])
  @@index([optionValueId])
}

enum PreOrderStatus {
  PENDING_BOOKING
  BOOKED
  AWAITING_BALANCE
  COMPLETED
  EXPIRED
  CANCELLED
  REFUNDED
}

model PreOrder {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  variantId String?
  variant   Variant? @relation(fields: [variantId], references: [id])
  quantity  Int      @default(1)
  addressId String?
  address   Address? @relation(fields: [addressId], references: [id])

  unitPrice       Decimal @db.Decimal(12,2)
  bookingAmount   Decimal @db.Decimal(12,2)
  shippingCharges Decimal @default(0) @db.Decimal(12,2)
  totalAmount     Decimal @db.Decimal(12,2)
  balanceAmount   Decimal @db.Decimal(12,2)

  status PreOrderStatus @default(PENDING_BOOKING)

  bookingRazorpayOrderId   String?   @unique
  bookingRazorpayPaymentId String?   @unique
  bookingPaidAt            DateTime?

  balanceToken             String?   @unique
  balanceRazorpayOrderId   String?   @unique
  balanceRazorpayPaymentId String?   @unique
  balancePaidAt            DateTime?
  notifiedAt               DateTime?
  balanceDueAt             DateTime?

  refundId   String?
  refundedAt DateTime?

  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id])

  idempotencyKey String @unique

  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([productId])
  @@index([status])
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  sessionId String?

  productId String
  product   Product @relation(fields: [productId], references: [id])
  variantId String?
  variant   Variant? @relation(fields: [variantId], references: [id])

  quantity Int @default(1)

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId, variantId])
  @@unique([sessionId, productId, variantId])
  @@index([sessionId])
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])

  deletedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Coupon {
  id            String      @id @default(uuid())
  code          String      @unique
  type          CouponType
  value         Decimal     @db.Decimal(12,2)
  minOrderValue Decimal?    @db.Decimal(12,2)
  maxDiscount   Decimal?    @db.Decimal(12,2)
  usageLimit    Int?
  usedCount     Int         @default(0)
  /// How many times ONE customer may use this coupon. Null = unlimited per user
  /// (the previous behaviour: only the global `usageLimit` applied, so a single
  /// customer could redeem a welcome offer as often as they liked).
  perUserLimit  Int?

  validFrom DateTime?
  validUntil DateTime?
  isActive   Boolean @default(true)

  orders Order[]

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURN_APPROVED
  RETURN_REJECTED
  RETURNED
  REFUND_INITIATED
  REFUNDED
}

enum PaymentMethod {
  ONLINE
  COD
}

/// How the customer agreed to pay for an order.
///
/// FULL is the historical behaviour and the default, so every pre-existing row reads
/// correctly with no backfill. PARTIAL means a deposit was charged online at checkout
/// and the remainder is collected later — at the door by the courier, online before
/// dispatch, or by hand from the admin panel.
///
/// This is deliberately NOT folded into `PaymentMethod`. A partial order's deposit is a
/// genuine online Razorpay capture, so `paymentMethod` stays ONLINE; the courier-collection
/// half is expressed by `balanceMethod` on Payment. Reusing PaymentMethod would flip
/// `paymentMethod` to COD mid-life, and both clients branch on `paymentMethod !== "COD"`
/// to decide whether to show refund copy — a cancelled partial order would silently stop
/// telling the customer about their money.
enum PaymentPlan {
  FULL
  PARTIAL
}

/// How the outstanding balance on a PARTIAL order actually arrived.
///
/// Written only at settlement, so there is no intent-vs-actual pair to keep in sync — the
/// courier manifest mode is derived from `paymentPlan` + `balanceSettledAt` at dispatch time.
enum BalanceMethod {
  ONLINE
  COD
  MANUAL
}

model Order {
  id        String @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id])

  addressId String
  address   Address @relation(fields: [addressId], references: [id])

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id])

  subtotal        Decimal @db.Decimal(12,2)
  discount        Decimal @default(0) @db.Decimal(12,2)
  shippingCharges Decimal @default(0) @db.Decimal(12,2)
  total           Decimal @db.Decimal(12,2)

  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @default(ONLINE)

  /// ── Partial payment (20% deposit now / balance at delivery) ──────────────────
  ///
  /// `paymentPlan` is the discriminator; every column below is NULL on a FULL order.
  ///
  /// The split is frozen at creation and NEVER recomputed: the configured percentage
  /// (env default, per-product/variant override) can change while orders are live, and a
  /// live order's obligation must not move under it.
  ///
  /// `depositAmount + balanceAmount = total` exactly, enforced by the
  /// `order_partial_split_sums` CHECK constraint added in the migration. The balance is a
  /// whole number of rupees because a courier collects it as cash and cannot make paise;
  /// the deposit absorbs the remainder, being charged by a gateway that handles paise fine.
  paymentPlan   PaymentPlan @default(FULL)
  depositAmount Decimal?    @db.Decimal(12,2)
  balanceAmount Decimal?    @db.Decimal(12,2)

  /// Written once, when the deposit captures. Anchors the pay-before-dispatch hold —
  /// `updatedAt` cannot, because any write bumps it (an admin editing `adminNote` would
  /// silently re-arm the hold; the same trap that once broke the return window).
  depositPaidAt DateTime?

  /// Addresses the public balance-payment link. Nulled at dispatch, which kills the link.
  balanceToken String? @unique

  /// Set the instant the order is claimed for a waybill while the balance is still
  /// outstanding. Non-null means a COD parcel is committed for that amount: the link is
  /// dead, and a late online balance capture must be refunded rather than applied.
  dispatchLockedAt DateTime?

  /// A retained deposit. Timestamp rather than boolean: null-as-false needs no backfill,
  /// "when" is what ops asks, and the reason separates an RTO from a customer cancellation
  /// for the P&L (only one of the two got its goods back).
  depositForfeitedAt   DateTime?
  depositForfeitReason String?

  providerRefId        String?
  providerShipmentId   String?
  trackingUrl          String?
  awbCode              String?

  customerNote String?
  adminNote    String?

  items                OrderItem[]
  payment              Payment?
  reviews              Review[]
  affiliateConversions AffiliateConversion[]
  commissions          Commission[]
  returns              Return[]
  shipments            Shipment[]
  preOrder             PreOrder?

  affiliateId String?
  affiliate   Affiliate? @relation(fields: [affiliateId], references: [id])

  idempotencyKey String @unique

  invoice Invoice?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([idempotencyKey])
  @@index([paymentMethod])
  @@index([paymentPlan])
  @@index([affiliateId])
  /// Backs the per-user coupon cap — Order already records both, so counting a
  /// customer's redemptions needs no separate redemption table.
  @@index([couponId, userId])
}


enum PaymentStatus {
  PENDING
  INITIATED
  /// Deposit captured on a PARTIAL order, balance still outstanding.
  ///
  /// A distinct member rather than SUCCESS-with-a-flag, because it makes most existing
  /// `status !== "SUCCESS"` guards do the right thing untouched: no GST invoice is issued
  /// at deposit time, the stale-order sweeper won't reclaim a deposit-paid order,
  /// `abandonOrderService` refuses to release it, and both clients already hide the invoice
  /// button — including published binaries we cannot update.
  ///
  /// It is also not PENDING: refund paths (`refundOrderMoney`, `resolveReturnService`,
  /// `handleRefundProcessed`) must be able to return a captured deposit, and a PENDING
  /// payment reads as "no money moved".
  PARTIALLY_PAID
  SUCCESS
  FAILED
  REFUND_INITIATED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id      String @id @default(uuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  method  PaymentMethod @default(ONLINE)
  gateway String        // "razorpay" | "cod"

  razorpayOrderId   String? @unique
  razorpayPaymentId String? @unique
  razorpaySignature String?

  amount   Decimal @db.Decimal(12,2)
  currency String  @default("INR")
  status   PaymentStatus @default(PENDING)

  refundId     String?
  refundAmount Decimal? @db.Decimal(12,2)
  refundedAt   DateTime?
  refundReason String?

  codCollectedAt DateTime?

  /// ── Balance leg (PARTIAL orders, and the pre-order booking/balance pair) ─────
  ///
  /// `amount` above records what the FIRST capture actually took — the deposit on a
  /// partial order. Recording the true captured amount is what keeps the webhook amount
  /// checks and refunds correct; the columns here carry the second leg.
  ///
  /// The two @unique gateway ids are the whole reason webhook leg-routing is cheap: a
  /// capture is matched by *which column it matched*, never by comparing amounts. Amount
  /// comparison would misclassify every pre-order-converted order.
  balanceAmount            Decimal?  @db.Decimal(12,2)
  balanceRazorpayOrderId   String?   @unique
  /// Set-once capture marker. A different second id raises P2002 rather than double-booking.
  balanceRazorpayPaymentId String?   @unique
  balancePaidAt            DateTime?
  balanceMethod            BalanceMethod?
  /// The single "balance is in" flag, whichever channel delivered it.
  balanceSettledAt         DateTime?
  balanceReference         String?
  /// Separate from `attempts`: sharing one counter would lock a customer who retried the
  /// deposit twice out of paying their balance online.
  balanceAttempts          Int       @default(0)

  balanceRefundId     String?
  balanceRefundAmount Decimal?  @db.Decimal(12,2)
  balanceRefundedAt   DateTime?

  /// Set ONLY by remittance reconciliation, never by a courier scan. DELIVERED means the
  /// parcel moved; only the remittance file means the money moved. Keeping the two apart
  /// is what makes "delivered but never paid" visible at all.
  codRemittedAt     DateTime?
  codRemittedAmount Decimal? @db.Decimal(12,2)

  /// Money owed back to the customer that no gateway can return — a returned order whose
  /// balance was collected as cash. Non-null and unsettled IS the admin payout queue.
  manualRefundAmount    Decimal?  @db.Decimal(12,2)
  manualRefundSettledAt DateTime?

  gatewayResponse Json?

  attempts Int @default(0)

  paymentIdempotencyKey String? @unique

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gateway, razorpayOrderId])
  @@index([razorpayPaymentId])
  @@index([balanceRazorpayOrderId])
  @@index([status])
  @@index([paymentIdempotencyKey])
}


model WebhookEvent {
  id        String @id @default(uuid())
  provider  String
  eventId   String
  eventType String

  payload     Json
  status      WebhookStatus @default(PENDING)
  processedAt DateTime?
  error       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, eventId])
  @@index([provider, eventType])
  @@index([status])
  @@index([createdAt])
}


model OrderItem {
  id        String @id @default(uuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  variantId String?
  variant   Variant? @relation(fields: [variantId], references: [id])

  quantity Int
  price    Decimal @db.Decimal(12,2)

  /// Product/variant names as they were when the order was placed. `price` was
  /// already snapshotted; names were not, so invoices and order history rendered
  /// the live `Product.name` and silently changed whenever a product was renamed.
  /// Nullable: rows created before this column fall back to the live relation.
  productName String?
  variantName String?

  deletedAt DateTime?
}

enum WebhookStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  SKIPPED
}

model AuditLog {
  id     String  @id @default(uuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  action   String
  entity   String
  entityId String

  oldValue Json?
  newValue Json?
  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
}

model Return {
  id      String @id @default(uuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])
  userId  String

  reason      String
  description String?
  status      ReturnStatus @default(PENDING)

  adminNote  String?
  resolvedBy String?
  resolvedAt DateTime?

  refundAmount Decimal?
  refundedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

model Shipment {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  providerRefId        String?
  providerShipmentId   String?
  awbCode              String?
  courierName          String?
  trackingUrl          String?

  status      ShipmentStatus @default(PENDING)
  estimatedAt DateTime?
  deliveredAt DateTime?

  trackingData Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([awbCode])
  @@index([status])
}

enum ShipmentStatus {
  PENDING
  PROCESSING
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

model Review {
  id        String  @id @default(uuid())
  userId    String
  productId String
  orderId   String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id])

  rating     Int
  comment    String?
  isApproved Boolean @default(true)

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId, rating])
}

enum AffiliateStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

enum CommissionType {
  PER_ORDER 
  LIFETIME 
}

model Affiliate {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status         AffiliateStatus @default(PENDING)
  referralCode   String          @unique
  commissionRate Decimal         @default(0.05) // 5% default, configurable 5-10%
  commissionType CommissionType  @default(LIFETIME)

  totalClicks      Int     @default(0)
  totalConversions Int     @default(0)
  totalCommission  Decimal @default(0)

  pendingBalance   Decimal @default(0)  
  paidOutBalance   Decimal @default(0)  

  payoutDetails Json? 


  adminNote  String?
  approvedAt DateTime?
  approvedBy String?

  clicks      AffiliateClick[]
  conversions AffiliateConversion[]
  commissions Commission[]
  withdrawals AffiliateWithdrawal[]
  orders      Order[]

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([referralCode])
}

model AffiliateClick {
  id          String    @id @default(uuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  ip          String?
  userAgent   String?
  referrer    String?
  country     String?  
  sessionId   String?  

  ipDateKey   String? 

  isUnique    Boolean  @default(true)  
  convertedAt DateTime? 

  createdAt DateTime @default(now())

  @@index([affiliateId, createdAt])
  @@index([ipDateKey])
  @@index([affiliateId, isUnique])
}

model AffiliateConversion {
  id          String @id @default(uuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  commission Decimal
  status     CommissionStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([affiliateId, orderId])
  @@index([affiliateId, status])
}

model Commission {
  id          String @id @default(uuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  amount Decimal @db.Decimal(12,2)
  status CommissionStatus @default(PENDING)

  paidAt         DateTime?
  reversedAt     DateTime?
  reversalReason String?

  approvedBy  String?
  approvedAt  DateTime?

  withdrawalId String?
  withdrawal   AffiliateWithdrawal? @relation(fields: [withdrawalId], references: [id])

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([affiliateId, orderId]) 
  @@index([affiliateId, status])
  @@index([orderId])
  @@index([withdrawalId])
  @@index([status])
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  PAID
  REJECTED
}

model AffiliateWithdrawal {
  id          String    @id @default(uuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  amount         Decimal
  status         WithdrawalStatus @default(PENDING)
  payoutDetails  Json?   
  adminNote      String?
  processedBy    String? 
  processedAt    DateTime?
  transactionRef String? 

  commissions Commission[] 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([affiliateId, status])
  @@index([status])
}

enum BannerPosition {
  HOME_HERO
  MOBILE_HERO
  HOME_MID
