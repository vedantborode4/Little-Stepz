// Little Stepz CRM database. Independent of the website database: its own
// container, credentials and generated client (output below), so the two
// Prisma clients can never overwrite each other.
//
// Conventions: UUID ids, money Decimal(14,2), unit costs / FX Decimal(18,6),
// UTC timestamps. Ledger-style tables are append-only (enforced by triggers in
// the migrations), so corrections are always new rows, never edits.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("CRM_DATABASE_URL")
}

// ─── Identity ────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  CASHIER
  OPS
}

model User {
  id                 String    @id @default(uuid())
  name               String
  email              String    @unique
  passwordHash       String
  role               Role
  isActive           Boolean   @default(true)
  /// Set when an admin creates the account or resets its password; the user must
  /// choose their own password before using the CRM.
  mustChangePassword Boolean   @default(true)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]
  priceChanges      PriceChange[]
  stockDocuments    StockDocument[]
  purchasesCreated  PurchaseShipment[] @relation("PurchaseCreatedBy")
  purchasesReceived PurchaseShipment[] @relation("PurchaseReceivedBy")
  costAdjustments   CostAdjustment[]
  purchaseReturns   PurchaseReturn[]
}

/// Opaque refresh tokens, stored only as a SHA-256 hash. Each login starts a
/// family; rotation keeps the family, and presenting an already-rotated token
/// revokes the whole family (token theft detection).
model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  familyId     String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

/// Append-only: UPDATE, DELETE and TRUNCATE are rejected by a trigger.
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Restrict)
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ─── Settings ────────────────────────────────────────────────────────────────

/// Single row (id = "default").
model BusinessProfile {
  id            String   @id @default("default")
  legalName     String
  tradeName     String
  gstin         String?
  /// GST state code, e.g. "36" for Telangana. Decides CGST+SGST vs IGST.
  stateCode     String
  addressLine   String
  city          String
  pincode       String
  phone         String?
  email         String?
  receiptFooter String?
  updatedAt     DateTime @updatedAt
}

enum LocationType {
  STORE
  WAREHOUSE
}

model Location {
  id        String       @id @default(uuid())
  /// Immutable once created — stock documents reference it.
  code      String       @unique
  name      String
  type      LocationType
  address   String?
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  stockMovements  StockMovement[]
  stockBalances   StockBalance[]
  purchases       PurchaseShipment[]
  purchaseReturns PurchaseReturn[]
}

enum PaymentMethod {
  CASH
  UPI
  GATEWAY
  BANK
  OTHER
}

/// Where money lands: cash drawer, business/personal PhonePe, bank, gateway.
/// Personal accounts are still business collections, but reported separately.
model ReceivingAccount {
  id         String        @id @default(uuid())
  name       String        @unique
  method     PaymentMethod
  isPersonal Boolean       @default(false)
  /// Default processing fee charged by the provider (e.g. gateway %), used for contribution profit.
  feePercent Decimal       @default(0) @db.Decimal(5, 2)
  details    String?
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

// ─── Document numbering ──────────────────────────────────────────────────────

/// Gapless per-prefix counters (PRD, PUR, ...). Incremented inside the
/// document's own transaction, so a rolled-back create never burns a number.
model Sequence {
  key   String @id
  value Int
}

// ─── Catalog ─────────────────────────────────────────────────────────────────

/// `nameKey` is the trimmed, lower-cased name: uniqueness is case-insensitive.
model Category {
  id        String    @id @default(uuid())
  name      String
  nameKey   String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Brand {
  id        String    @id @default(uuid())
  name      String
  nameKey   String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Supplier {
  id          String             @id @default(uuid())
  name        String
  nameKey     String             @unique
  country     String?
  /// ISO code of the currency the supplier invoices in (CNY for RMB).
  currency    String             @default("INR")
  contactName String?
  phone       String?
  email       String?
  address     String?
  gstin       String?
  notes       String?
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  products    Product[]
  purchases   PurchaseShipment[]
}

enum ProductStatus {
  DRAFT
  ACTIVE
  DISCONTINUED
  ARCHIVED
}

enum VariantStatus {
  ACTIVE
  ARCHIVED
}

/// Products are never deleted (stock and sales reference them); they are archived.
/// Every product has at least one Variant — a simple product has a single
/// "Default" variant — so SKU, price and stock always live on the variant.
model Product {
  id               String        @id @default(uuid())
  code             String        @unique
  name             String
  categoryId       String
  category         Category      @relation(fields: [categoryId], references: [id])
  brandId          String?
  brand            Brand?        @relation(fields: [brandId], references: [id])
  supplierId       String?
  supplier         Supplier?     @relation(fields: [supplierId], references: [id])
  scale            String?
  status           ProductStatus @default(ACTIVE)
  imageUrl         String?
  description      String?
  notes            String?
  hsnCode          String?
  gstRate          Decimal       @db.Decimal(5, 2)
  /// Read-only reference to the website's product id. Never used to write to the website.
  websiteProductId String?       @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  options  ProductOption[]
  variants Variant[]

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([name])
}

model ProductOption {
  id        String               @id @default(uuid())
  productId String
  product   Product              @relation(fields: [productId], references: [id])
  name      String
  position  Int
  values    ProductOptionValue[]

  @@unique([productId, name])
}

model ProductOptionValue {
  id       String               @id @default(uuid())
  optionId String
  option   ProductOption        @relation(fields: [optionId], references: [id])
  value    String
  position Int
  variants VariantOptionValue[]

  @@unique([optionId, value])
}

model Variant {
  id               String        @id @default(uuid())
  productId        String
  product          Product       @relation(fields: [productId], references: [id])
  /// Stored upper-case, so uniqueness is case-insensitive.
  sku              String        @unique
  name             String
  /// Sorted option-value ids joined by "|" ("" for a simple product's only variant).
  /// Unique per product: the same combination can't exist twice.
  optionKey        String
  regularPrice     Decimal       @db.Decimal(14, 2)
  offerPrice       Decimal?      @db.Decimal(14, 2)
  wholesalePrice   Decimal?      @db.Decimal(14, 2)
  reorderLevel     Int           @default(0)
  websiteVariantId String?       @unique
  status           VariantStatus @default(ACTIVE)
  position         Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  optionValues        VariantOptionValue[]
  priceTiers          PriceTier[]
  priceChanges        PriceChange[]
  stockMovements      StockMovement[]
  stockBalances       StockBalance[]
  cost                VariantCost?
  purchaseLines       PurchaseLine[]
  costAdjustmentLines CostAdjustmentLine[]
  purchaseReturnLines PurchaseReturnLine[]
  customerPrices      CustomerPrice[]

  @@unique([productId, optionKey])
  @@index([productId])
}

model VariantOptionValue {
  variantId     String
  variant       Variant            @relation(fields: [variantId], references: [id])
  optionValueId String
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id])

  @@id([variantId, optionValueId])
}

/// Quantity-break wholesale pricing: buying >= minQty units costs `price` each.
model PriceTier {
  id        String  @id @default(uuid())
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  minQty    Int
  price     Decimal @db.Decimal(14, 2)

  @@unique([variantId, minQty])
}

enum PriceField {
  REGULAR
  OFFER
  WHOLESALE
}

/// Append-only price history (single edits and bulk batches). Completed sales
/// keep their own price snapshot; this records what the list price was and when.
model PriceChange {
  id          String     @id @default(uuid())
  variantId   String
  variant     Variant    @relation(fields: [variantId], references: [id])
  field       PriceField
  oldPrice    Decimal?   @db.Decimal(14, 2)
  newPrice    Decimal?   @db.Decimal(14, 2)
  batchId     String?
  reason      String?
  changedById String?
  changedBy   User?      @relation(fields: [changedById], references: [id])
  createdAt   DateTime   @default(now())

  @@index([variantId, createdAt])
  @@index([batchId])
}

// ─── Inventory ledger ────────────────────────────────────────────────────────

/// Physical stock is the sum of all buckets; only SELLABLE stock can be sold.
/// Moving a unit between buckets never changes physical stock, so damaged or
/// demo units are never counted twice.
enum StockBucket {
  SELLABLE
  DAMAGED
  DEMO
  QUARANTINE
}

enum StockDocumentType {
  OPENING
  PURCHASE
  SALE
  SALE_RETURN
  PURCHASE_RETURN
  TRANSFER
  BUCKET_MOVE
  WRITE_OFF
  ADJUSTMENT
  REVERSAL
}

enum StockReasonCode {
  MISSING
  DAMAGED
  DEMO_USE
  THEFT
  COUNT_CORRECTION
  FOUND
  DATA_ENTRY_ERROR
  OTHER
}

/// One stock event (an opening entry, a transfer, a write-off...). Append-only:
/// a mistake is corrected by a REVERSAL document pointing at it, at most once.
model StockDocument {
  id           String            @id @default(uuid())
  code         String            @unique
  type         StockDocumentType
  /// The business day the movement happened (IST calendar date).
  businessDate DateTime          @db.Date
  reasonCode   StockReasonCode?
  reason       String
  reference    String?
  notes        String?
  /// The purchase, sale or count that produced this document, when there is one.
  sourceType   String?
  sourceId     String?
  reversalOfId String?           @unique
  reversalOf   StockDocument?    @relation("StockReversal", fields: [reversalOfId], references: [id])
  reversedBy   StockDocument?    @relation("StockReversal")
  createdById  String?
  createdBy    User?             @relation(fields: [createdById], references: [id])
  createdAt    DateTime          @default(now())

  lines          StockMovement[]
  purchase       PurchaseShipment? @relation("PurchaseStockDocument")
  purchaseReturn PurchaseReturn?   @relation("PurchaseReturnStockDocument")

  @@index([type, businessDate])
  @@index([sourceType, sourceId])
  @@index([createdAt])
}

/// A signed quantity change for one variant, location and bucket. `unitCost` is
/// the cost the units moved at (null when unknown — never guessed).
model StockMovement {
  id         String        @id @default(uuid())
  documentId String
  document   StockDocument @relation(fields: [documentId], references: [id])
  variantId  String
  variant    Variant       @relation(fields: [variantId], references: [id])
  locationId String
  location   Location      @relation(fields: [locationId], references: [id])
  bucket     StockBucket
  quantity   Int
  unitCost   Decimal?      @db.Decimal(18, 6)
  createdAt  DateTime      @default(now())

  @@index([variantId, createdAt])
  @@index([locationId])
  @@index([documentId])
}

/// Running balance cache, written only in the same transaction as the movement
/// that changes it. A CHECK keeps it from ever going negative.
model StockBalance {
  variantId  String
  variant    Variant     @relation(fields: [variantId], references: [id])
  locationId String
  location   Location    @relation(fields: [locationId], references: [id])
  bucket     StockBucket
  quantity   Int         @default(0)
  updatedAt  DateTime    @updatedAt

  @@id([variantId, locationId, bucket])
  @@index([locationId, bucket])
}

/// Moving weighted-average cost per variant (across locations). Units whose cost
/// is unknown (e.g. opening stock entered without a cost) are tracked separately
/// so they never distort the average or get an invented value.
model VariantCost {
  variantId   String   @id
  variant     Variant  @relation(fields: [variantId], references: [id])
  valuedQty   Int      @default(0)
  totalValue  Decimal  @default(0) @db.Decimal(20, 6)
  unvaluedQty Int      @default(0)
  updatedAt   DateTime @updatedAt
}

// ─── Purchasing & landed cost ────────────────────────────────────────────────

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

/// How shared shipment charges are split across lines.
enum AllocationMethod {
  VALUE
  QUANTITY
  WEIGHT
  VOLUME
}

enum ChargeType {
  FREIGHT
  CUSTOMS_DUTY
  CLEARING
  IGST
  GST
  LOCAL_TRANSPORT
  INSURANCE
  OTHER
}

/// One supplier invoice / shipment. Editable as a DRAFT; receiving freezes the
/// landed cost of every line and posts the PURCHASE stock document. After that a
/// trigger locks the header, lines and charges — corrections are cost adjustments
/// and purchase returns, never edits.
model PurchaseShipment {
  id               String           @id @default(uuid())
  code             String           @unique
  status           PurchaseStatus   @default(DRAFT)
  supplierId       String
  supplier         Supplier         @relation(fields: [supplierId], references: [id])
  invoiceNumber    String?
  shipmentRef      String?
  invoiceDate      DateTime         @db.Date
  /// ISO currency of the supplier invoice (CNY for RMB).
  currency         String
  /// INR per 1 unit of `currency`, entered per purchase (1 for INR).
  exchangeRate     Decimal          @db.Decimal(18, 6)
  allocationMethod AllocationMethod @default(VALUE)
  locationId       String
  location         Location         @relation(fields: [locationId], references: [id])
  notes            String?
  receivedAt       DateTime?
  receivedDate     DateTime?        @db.Date
  receivedById     String?
  receivedBy       User?            @relation("PurchaseReceivedBy", fields: [receivedById], references: [id])
  stockDocumentId  String?          @unique
  stockDocument    StockDocument?   @relation("PurchaseStockDocument", fields: [stockDocumentId], references: [id])
  createdById      String?
  createdBy        User?            @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  lines           PurchaseLine[]
  charges         ShipmentCharge[]
  costAdjustments CostAdjustment[]
  returns         PurchaseReturn[]

  @@index([supplierId])
  @@index([status, invoiceDate])
}

model PurchaseLine {
  id               String           @id @default(uuid())
  shipmentId       String
  shipment         PurchaseShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  variantId        String
  variant          Variant          @relation(fields: [variantId], references: [id])
  quantity         Int
  /// Price per unit in the shipment currency.
  unitPrice        Decimal          @db.Decimal(18, 6)
  /// Per-unit weight / volume, needed only for those allocation methods.
  weightKg         Decimal?         @db.Decimal(12, 3)
  cbm              Decimal?         @db.Decimal(12, 6)
  position         Int
  /// Frozen at receipt.
  unitPriceInr     Decimal?         @db.Decimal(18, 6)
  allocatedCharges Decimal?         @db.Decimal(18, 6)
  landedUnitCost   Decimal?         @db.Decimal(18, 6)

  returnLines PurchaseReturnLine[]

  @@unique([shipmentId, variantId])
}

model ShipmentCharge {
  id               String           @id @default(uuid())
  shipmentId       String
  shipment         PurchaseShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  type             ChargeType
  description      String?
  amount           Decimal          @db.Decimal(14, 2)
  /// INR or the shipment currency.
  currency         String
  amountInr        Decimal          @db.Decimal(14, 2)
  /// Input GST / IGST that can be claimed back: kept out of inventory cost.
  isRecoverableTax Boolean          @default(false)
}

/// A charge that arrived after the goods were received. The share for units
/// still on hand revalues stock; the share for units already gone is expensed
/// as cost of goods sold. Append-only.
model CostAdjustment {
  id               String           @id @default(uuid())
  code             String           @unique
  shipmentId       String
  shipment         PurchaseShipment @relation(fields: [shipmentId], references: [id])
  type             ChargeType
  description      String?
  amountInr        Decimal          @db.Decimal(14, 2)
  isRecoverableTax Boolean
  allocationMethod AllocationMethod
  businessDate     DateTime         @db.Date
  createdById      String?
  createdBy        User?            @relation(fields: [createdById], references: [id])
  createdAt        DateTime         @default(now())

  lines CostAdjustmentLine[]
}

model CostAdjustmentLine {
  id            String         @id @default(uuid())
  adjustmentId  String
  adjustment    CostAdjustment @relation(fields: [adjustmentId], references: [id])
  variantId     String
  variant       Variant        @relation(fields: [variantId], references: [id])
  allocated     Decimal        @db.Decimal(18, 6)
  toInventory   Decimal        @db.Decimal(18, 6)
  toCostOfSales Decimal        @db.Decimal(18, 6)
}

/// Goods sent back to the supplier from a received purchase. Append-only.
model PurchaseReturn {
  id              String           @id @default(uuid())
  code            String           @unique
  shipmentId      String
  shipment        PurchaseShipment @relation(fields: [shipmentId], references: [id])
  locationId      String
  location        Location         @relation(fields: [locationId], references: [id])
  businessDate    DateTime         @db.Date
  reason          String
  stockDocumentId String           @unique
  stockDocument   StockDocument    @relation("PurchaseReturnStockDocument", fields: [stockDocumentId], references: [id])
  createdById     String?
  createdBy       User?            @relation(fields: [createdById], references: [id])
  createdAt       DateTime         @default(now())

  lines PurchaseReturnLine[]
}

model PurchaseReturnLine {
  id             String         @id @default(uuid())
  returnId       String
  purchaseReturn PurchaseReturn @relation(fields: [returnId], references: [id])
  purchaseLineId String
  purchaseLine   PurchaseLine   @relation(fields: [purchaseLineId], references: [id])
  variantId      String
  variant        Variant        @relation(fields: [variantId], references: [id])
  quantity       Int
}

// ─── Customers ───────────────────────────────────────────────────────────────

enum CustomerType {
  RETAIL
  WHOLESALE
}

/// Walk-in sales have no customer. `mobile` is E.164 and unique, so the same
/// person can't be created twice by phone. Merging folds a duplicate into the
/// customer that is kept and leaves this row behind as an inactive pointer.
model Customer {
  id           String       @id @default(uuid())
  code         String       @unique
  name         String
  /// Lower-cased, single-spaced name; trigram-indexed for "similar name" checks.
  nameKey      String
  mobile       String?      @unique
  whatsapp     String?
  email        String?
  addressLine  String?
  city         String?
  /// GST state code (place of supply for shipped orders).
  stateCode    String?
  pincode      String?
  type         CustomerType @default(RETAIL)
  /// Days allowed to pay; null means pay at purchase.
  creditDays   Int?
  creditLimit  Decimal?     @db.Decimal(14, 2)
  notes        String?
  isActive     Boolean      @default(true)
  mergedIntoId String?
  mergedInto   Customer?    @relation("CustomerMerge", fields: [mergedIntoId], references: [id])
  mergedFrom   Customer[]   @relation("CustomerMerge")
  mergedAt     DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  prices CustomerPrice[]

  @@index([nameKey(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([pincode])
  @@index([type])
}

/// A negotiated price for one customer and variant; it wins over every list price.
model CustomerPrice {
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  variantId  String
  variant    Variant  @relation(fields: [variantId], references: [id])
  price      Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@id([customerId, variantId])
  @@index([variantId])
}
