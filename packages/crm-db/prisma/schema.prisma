// Little Stepz CRM database. Independent of the website database: its own
// container, credentials and generated client (output below), so the two
// Prisma clients can never overwrite each other.
//
// Conventions: UUID ids, money Decimal(14,2), unit costs / FX Decimal(18,6),
// UTC timestamps. Ledger-style tables are append-only (enforced by triggers in
// the migrations), so corrections are always new rows, never edits.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("CRM_DATABASE_URL")
}

// ─── Identity ────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  CASHIER
  OPS
}

model User {
  id                 String    @id @default(uuid())
  name               String
  email              String    @unique
  passwordHash       String
  role               Role
  isActive           Boolean   @default(true)
  /// Set when an admin creates the account or resets its password; the user must
  /// choose their own password before using the CRM.
  mustChangePassword Boolean   @default(true)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  refreshTokens        RefreshToken[]
  auditLogs            AuditLog[]
  priceChanges         PriceChange[]
  stockDocuments       StockDocument[]
  purchasesCreated     PurchaseShipment[]    @relation("PurchaseCreatedBy")
  purchasesReceived    PurchaseShipment[]    @relation("PurchaseReceivedBy")
  costAdjustments      CostAdjustment[]
  purchaseReturns      PurchaseReturn[]
  salesOrders          SalesOrder[]
  salesOrderEvents     SalesOrderEvent[]
  payments             Payment[]
  creditEntries        CustomerCreditEntry[]
  accountTransfers     AccountTransfer[]
  salesReturns         SalesReturn[]
  shipments            Shipment[]
  shipmentEvents       ShipmentEvent[]
  expenses             Expense[]
  cashOpened           CashSession[]         @relation("CashOpenedBy")
  cashClosed           CashSession[]         @relation("CashClosedBy")
  stockCounts          StockCount[]          @relation("StockCountCreatedBy")
  stockCountsSubmitted StockCount[]          @relation("StockCountSubmittedBy")
  stockCountsApproved  StockCount[]          @relation("StockCountApprovedBy")
  importTemplates      ImportTemplate[]
  importsCreated       ImportBatch[]         @relation("ImportCreatedBy")
  importsApproved      ImportBatch[]         @relation("ImportApprovedBy")
  importsRolledBack    ImportBatch[]         @relation("ImportRolledBackBy")
  syncRuns             SyncRun[]
}

/// Opaque refresh tokens, stored only as a SHA-256 hash. Each login starts a
/// family; rotation keeps the family, and presenting an already-rotated token
/// revokes the whole family (token theft detection).
model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  familyId     String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

/// Append-only: UPDATE, DELETE and TRUNCATE are rejected by a trigger.
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Restrict)
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ─── Settings ────────────────────────────────────────────────────────────────

/// Single row (id = "default").
model BusinessProfile {
  id            String   @id @default("default")
  legalName     String
  tradeName     String
  gstin         String?
  /// GST state code, e.g. "36" for Telangana. Decides CGST+SGST vs IGST.
  stateCode     String
  addressLine   String
  city          String
  pincode       String
  phone         String?
  email         String?
  receiptFooter String?
  updatedAt     DateTime @updatedAt
}

enum LocationType {
  STORE
  WAREHOUSE
}

model Location {
  id        String       @id @default(uuid())
  /// Immutable once created — stock documents reference it.
  code      String       @unique
  name      String
  type      LocationType
  address   String?
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  stockMovements  StockMovement[]
  stockBalances   StockBalance[]
  purchases       PurchaseShipment[]
  purchaseReturns PurchaseReturn[]
  salesOrders     SalesOrder[]
  reservations    Reservation[]
  salesReturns    SalesReturn[]
  stockCounts     StockCount[]
  importBatches   ImportBatch[]
}

enum PaymentMethod {
  CASH
  UPI
  GATEWAY
  BANK
  OTHER
}

/// Where money lands: cash drawer, business/personal PhonePe, bank, gateway.
/// Personal accounts are still business collections, but reported separately.
model ReceivingAccount {
  id         String        @id @default(uuid())
  name       String        @unique
  method     PaymentMethod
  isPersonal Boolean       @default(false)
  /// Default processing fee charged by the provider (e.g. gateway %), used for contribution profit.
  feePercent Decimal       @default(0) @db.Decimal(5, 2)
  details    String?
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  payments     Payment[]
  transfersOut AccountTransfer[] @relation("TransferFrom")
  transfersIn  AccountTransfer[] @relation("TransferTo")
  expenses     Expense[]
  cashSessions CashSession[]
}

// ─── Document numbering ──────────────────────────────────────────────────────

/// Gapless per-prefix counters (PRD, PUR, ...). Incremented inside the
/// document's own transaction, so a rolled-back create never burns a number.
model Sequence {
  key   String @id
  value Int
}

// ─── Catalog ─────────────────────────────────────────────────────────────────

/// `nameKey` is the trimmed, lower-cased name: uniqueness is case-insensitive.
model Category {
  id          String       @id @default(uuid())
  name        String
  nameKey     String       @unique
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  products    Product[]
  stockCounts StockCount[]
}

model Brand {
  id        String    @id @default(uuid())
  name      String
  nameKey   String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Supplier {
  id          String             @id @default(uuid())
  name        String
  nameKey     String             @unique
  country     String?
  /// ISO code of the currency the supplier invoices in (CNY for RMB).
  currency    String             @default("INR")
  contactName String?
  phone       String?
  email       String?
  address     String?
  gstin       String?
  notes       String?
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  products    Product[]
  purchases   PurchaseShipment[]
}

enum ProductStatus {
  DRAFT
  ACTIVE
  DISCONTINUED
  ARCHIVED
}

enum VariantStatus {
  ACTIVE
  ARCHIVED
}

/// Products are never deleted (stock and sales reference them); they are archived.
/// Every product has at least one Variant — a simple product has a single
/// "Default" variant — so SKU, price and stock always live on the variant.
model Product {
  id               String        @id @default(uuid())
  code             String        @unique
  name             String
  categoryId       String
  category         Category      @relation(fields: [categoryId], references: [id])
  brandId          String?
  brand            Brand?        @relation(fields: [brandId], references: [id])
  supplierId       String?
  supplier         Supplier?     @relation(fields: [supplierId], references: [id])
  scale            String?
  status           ProductStatus @default(ACTIVE)
  imageUrl         String?
  description      String?
  notes            String?
  hsnCode          String?
  gstRate          Decimal       @db.Decimal(5, 2)
  /// Read-only reference to the website's product id. Never used to write to the website.
  websiteProductId String?       @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  options  ProductOption[]
  variants Variant[]
  images   ProductImage[]

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([name])
}

model ProductOption {
  id        String               @id @default(uuid())
  productId String
  product   Product              @relation(fields: [productId], references: [id])
  name      String
  position  Int
  values    ProductOptionValue[]

  @@unique([productId, name])
}

model ProductOptionValue {
  id       String               @id @default(uuid())
  optionId String
  option   ProductOption        @relation(fields: [optionId], references: [id])
  value    String
  position Int
  variants VariantOptionValue[]

  @@unique([optionId, value])
}

enum ProductImageSource {
  /// Uploaded through the CRM into its own Cloudinary folder; the CRM may delete it there.
  UPLOAD
  /// A link to a photo hosted elsewhere (the website, a supplier). Never deleted at its source.
  LINK
}

/// A product's photo gallery. The first photo is the main one and is copied to
/// Product.imageUrl so lists, POS and stock screens need no join. A photo can
/// belong to one variant (a colour); otherwise it shows for the whole product.
model ProductImage {
  id          String             @id @default(uuid())
  productId   String
  product     Product            @relation(fields: [productId], references: [id])
  variantId   String?
  variant     Variant?           @relation(fields: [variantId], references: [id])
  url         String
  /// Cloudinary public id; set only for UPLOAD photos.
  publicId    String?
  source      ProductImageSource
  position    Int
  createdById String?
  createdAt   DateTime           @default(now())

  @@index([productId, position])
  @@index([variantId])
}

model Variant {
  id               String        @id @default(uuid())
  productId        String
  product          Product       @relation(fields: [productId], references: [id])
  /// Stored upper-case, so uniqueness is case-insensitive.
  sku              String        @unique
  name             String
  /// Sorted option-value ids joined by "|" ("" for a simple product's only variant).
  /// Unique per product: the same combination can't exist twice.
  optionKey        String
  regularPrice     Decimal       @db.Decimal(14, 2)
  offerPrice       Decimal?      @db.Decimal(14, 2)
  wholesalePrice   Decimal?      @db.Decimal(14, 2)
  reorderLevel     Int           @default(0)
  websiteVariantId String?       @unique
  status           VariantStatus @default(ACTIVE)
  position         Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  optionValues        VariantOptionValue[]
  priceTiers          PriceTier[]
  priceChanges        PriceChange[]
  stockMovements      StockMovement[]
  stockBalances       StockBalance[]
  cost                VariantCost?
  purchaseLines       PurchaseLine[]
  costAdjustmentLines CostAdjustmentLine[]
  purchaseReturnLines PurchaseReturnLine[]
  customerPrices      CustomerPrice[]
  salesOrderLines     SalesOrderLine[]
  reservations        Reservation[]
  salesReturnLines    SalesReturnLine[]
  stockCountLines     StockCountLine[]
  images              ProductImage[]

  @@unique([productId, optionKey])
  @@index([productId])
}

model VariantOptionValue {
  variantId     String
  variant       Variant            @relation(fields: [variantId], references: [id])
  optionValueId String
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id])

  @@id([variantId, optionValueId])
}

/// Quantity-break wholesale pricing: buying >= minQty units costs `price` each.
model PriceTier {
  id        String  @id @default(uuid())
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  minQty    Int
  price     Decimal @db.Decimal(14, 2)

  @@unique([variantId, minQty])
}

enum PriceField {
  REGULAR
  OFFER
  WHOLESALE
}

/// Append-only price history (single edits and bulk batches). Completed sales
/// keep their own price snapshot; this records what the list price was and when.
model PriceChange {
  id          String     @id @default(uuid())
  variantId   String
  variant     Variant    @relation(fields: [variantId], references: [id])
  field       PriceField
  oldPrice    Decimal?   @db.Decimal(14, 2)
  newPrice    Decimal?   @db.Decimal(14, 2)
  batchId     String?
  reason      String?
  changedById String?
  changedBy   User?      @relation(fields: [changedById], references: [id])
  createdAt   DateTime   @default(now())

  @@index([variantId, createdAt])
  @@index([batchId])
}

// ─── Inventory ledger ────────────────────────────────────────────────────────

/// Physical stock is the sum of all buckets; only SELLABLE stock can be sold.
/// Moving a unit between buckets never changes physical stock, so damaged or
/// demo units are never counted twice.
enum StockBucket {
  SELLABLE
  DAMAGED
  DEMO
  QUARANTINE
}

enum StockDocumentType {
  OPENING
  PURCHASE
  SALE
  SALE_RETURN
  PURCHASE_RETURN
  TRANSFER
  BUCKET_MOVE
  WRITE_OFF
  ADJUSTMENT
  REVERSAL
}

enum StockReasonCode {
  MISSING
  DAMAGED
  DEMO_USE
  THEFT
  COUNT_CORRECTION
  FOUND
  DATA_ENTRY_ERROR
  OTHER
}

/// One stock event (an opening entry, a transfer, a write-off...). Append-only:
/// a mistake is corrected by a REVERSAL document pointing at it, at most once.
model StockDocument {
  id           String            @id @default(uuid())
  code         String            @unique
  type         StockDocumentType
  /// The business day the movement happened (IST calendar date).
  businessDate DateTime          @db.Date
  reasonCode   StockReasonCode?
  reason       String
  reference    String?
  notes        String?
  /// The purchase, sale or count that produced this document, when there is one.
  sourceType   String?
  sourceId     String?
  reversalOfId String?           @unique
  reversalOf   StockDocument?    @relation("StockReversal", fields: [reversalOfId], references: [id])
  reversedBy   StockDocument?    @relation("StockReversal")
  createdById  String?
  createdBy    User?             @relation(fields: [createdById], references: [id])
  createdAt    DateTime          @default(now())

  lines          StockMovement[]
  salesOrder     SalesOrder?       @relation("SalesOrderStockDocument")
  salesReturn    SalesReturn?      @relation("SalesReturnStockDocument")
  stockCount     StockCount?       @relation("StockCountAdjustment")
  purchase       PurchaseShipment? @relation("PurchaseStockDocument")
  purchaseReturn PurchaseReturn?   @relation("PurchaseReturnStockDocument")

  @@index([type, businessDate])
  @@index([sourceType, sourceId])
  @@index([createdAt])
}

/// A signed quantity change for one variant, location and bucket. `unitCost` is
/// the cost the units moved at (null when unknown — never guessed).
model StockMovement {
  id         String        @id @default(uuid())
  documentId String
  document   StockDocument @relation(fields: [documentId], references: [id])
  variantId  String
  variant    Variant       @relation(fields: [variantId], references: [id])
  locationId String
  location   Location      @relation(fields: [locationId], references: [id])
  bucket     StockBucket
  quantity   Int
  unitCost   Decimal?      @db.Decimal(18, 6)
  createdAt  DateTime      @default(now())

  @@index([variantId, createdAt])
  @@index([locationId])
  @@index([documentId])
}

/// Running balance cache, written only in the same transaction as the movement
/// that changes it. A CHECK keeps it from ever going negative.
model StockBalance {
  variantId  String
  variant    Variant     @relation(fields: [variantId], references: [id])
  locationId String
  location   Location    @relation(fields: [locationId], references: [id])
  bucket     StockBucket
  quantity   Int         @default(0)
  updatedAt  DateTime    @updatedAt

  @@id([variantId, locationId, bucket])
  @@index([locationId, bucket])
}

/// Moving weighted-average cost per variant (across locations). Units whose cost
/// is unknown (e.g. opening stock entered without a cost) are tracked separately
/// so they never distort the average or get an invented value.
model VariantCost {
  variantId   String   @id
  variant     Variant  @relation(fields: [variantId], references: [id])
  valuedQty   Int      @default(0)
  totalValue  Decimal  @default(0) @db.Decimal(20, 6)
  unvaluedQty Int      @default(0)
  updatedAt   DateTime @updatedAt
}

// ─── Purchasing & landed cost ────────────────────────────────────────────────

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

/// How shared shipment charges are split across lines.
enum AllocationMethod {
  VALUE
  QUANTITY
  WEIGHT
  VOLUME
}

enum ChargeType {
  FREIGHT
  CUSTOMS_DUTY
  CLEARING
  IGST
  GST
  LOCAL_TRANSPORT
  INSURANCE
  OTHER
}

/// One supplier invoice / shipment. Editable as a DRAFT; receiving freezes the
/// landed cost of every line and posts the PURCHASE stock document. After that a
/// trigger locks the header, lines and charges — corrections are cost adjustments
/// and purchase returns, never edits.
model PurchaseShipment {
  id               String           @id @default(uuid())
  code             String           @unique
  status           PurchaseStatus   @default(DRAFT)
  supplierId       String
  supplier         Supplier         @relation(fields: [supplierId], references: [id])
  invoiceNumber    String?
  shipmentRef      String?
  invoiceDate      DateTime         @db.Date
  /// ISO currency of the supplier invoice (CNY for RMB).
  currency         String
  /// INR per 1 unit of `currency`, entered per purchase (1 for INR).
  exchangeRate     Decimal          @db.Decimal(18, 6)
  allocationMethod AllocationMethod @default(VALUE)
  locationId       String
  location         Location         @relation(fields: [locationId], references: [id])
  notes            String?
  receivedAt       DateTime?
  receivedDate     DateTime?        @db.Date
  receivedById     String?
  receivedBy       User?            @relation("PurchaseReceivedBy", fields: [receivedById], references: [id])
  stockDocumentId  String?          @unique
  stockDocument    StockDocument?   @relation("PurchaseStockDocument", fields: [stockDocumentId], references: [id])
  createdById      String?
  createdBy        User?            @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  lines           PurchaseLine[]
  charges         ShipmentCharge[]
  costAdjustments CostAdjustment[]
  returns         PurchaseReturn[]

  @@index([supplierId])
  @@index([status, invoiceDate])
}

model PurchaseLine {
  id               String           @id @default(uuid())
  shipmentId       String
  shipment         PurchaseShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  variantId        String
  variant          Variant          @relation(fields: [variantId], references: [id])
  quantity         Int
  /// Price per unit in the shipment currency.
  unitPrice        Decimal          @db.Decimal(18, 6)
  /// Per-unit weight / volume, needed only for those allocation methods.
  weightKg         Decimal?         @db.Decimal(12, 3)
  cbm              Decimal?         @db.Decimal(12, 6)
  position         Int
  /// Frozen at receipt.
  unitPriceInr     Decimal?         @db.Decimal(18, 6)
  allocatedCharges Decimal?         @db.Decimal(18, 6)
  landedUnitCost   Decimal?         @db.Decimal(18, 6)

  returnLines PurchaseReturnLine[]

  @@unique([shipmentId, variantId])
}

model ShipmentCharge {
  id               String           @id @default(uuid())
  shipmentId       String
  shipment         PurchaseShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  type             ChargeType
  description      String?
  amount           Decimal          @db.Decimal(14, 2)
  /// INR or the shipment currency.
  currency         String
  amountInr        Decimal          @db.Decimal(14, 2)
  /// Input GST / IGST that can be claimed back: kept out of inventory cost.
  isRecoverableTax Boolean          @default(false)
}

/// A charge that arrived after the goods were received. The share for units
/// still on hand revalues stock; the share for units already gone is expensed
/// as cost of goods sold. Append-only.
model CostAdjustment {
  id               String           @id @default(uuid())
  code             String           @unique
  shipmentId       String
  shipment         PurchaseShipment @relation(fields: [shipmentId], references: [id])
  type             ChargeType
  description      String?
  amountInr        Decimal          @db.Decimal(14, 2)
  isRecoverableTax Boolean
  allocationMethod AllocationMethod
  businessDate     DateTime         @db.Date
  createdById      String?
  createdBy        User?            @relation(fields: [createdById], references: [id])
  createdAt        DateTime         @default(now())

  lines CostAdjustmentLine[]
}

model CostAdjustmentLine {
  id            String         @id @default(uuid())
  adjustmentId  String
  adjustment    CostAdjustment @relation(fields: [adjustmentId], references: [id])
  variantId     String
  variant       Variant        @relation(fields: [variantId], references: [id])
  allocated     Decimal        @db.Decimal(18, 6)
  toInventory   Decimal        @db.Decimal(18, 6)
  toCostOfSales Decimal        @db.Decimal(18, 6)
}

/// Goods sent back to the supplier from a received purchase. Append-only.
model PurchaseReturn {
  id              String           @id @default(uuid())
  code            String           @unique
  shipmentId      String
  shipment        PurchaseShipment @relation(fields: [shipmentId], references: [id])
  locationId      String
  location        Location         @relation(fields: [locationId], references: [id])
  businessDate    DateTime         @db.Date
  reason          String
  stockDocumentId String           @unique
  stockDocument   StockDocument    @relation("PurchaseReturnStockDocument", fields: [stockDocumentId], references: [id])
  createdById     String?
  createdBy       User?            @relation(fields: [createdById], references: [id])
  createdAt       DateTime         @default(now())

  lines PurchaseReturnLine[]
}

model PurchaseReturnLine {
  id             String         @id @default(uuid())
  returnId       String
  purchaseReturn PurchaseReturn @relation(fields: [returnId], references: [id])
  purchaseLineId String
  purchaseLine   PurchaseLine   @relation(fields: [purchaseLineId], references: [id])
  variantId      String
  variant        Variant        @relation(fields: [variantId], references: [id])
  quantity       Int
}

// ─── Customers ───────────────────────────────────────────────────────────────

enum CustomerType {
  RETAIL
  WHOLESALE
}

/// Walk-in sales have no customer. `mobile` is E.164 and unique, so the same
/// person can't be created twice by phone. Merging folds a duplicate into the
/// customer that is kept and leaves this row behind as an inactive pointer.
model Customer {
  id           String       @id @default(uuid())
  code         String       @unique
  name         String
  /// Lower-cased, single-spaced name; trigram-indexed for "similar name" checks.
  nameKey      String
  mobile       String?      @unique
  whatsapp     String?
  email        String?
  addressLine  String?
  city         String?
  /// GST state code (place of supply for shipped orders).
  stateCode    String?
  pincode      String?
  type         CustomerType @default(RETAIL)
  /// Days allowed to pay; null means pay at purchase.
  creditDays   Int?
  creditLimit  Decimal?     @db.Decimal(14, 2)
  notes        String?
  isActive     Boolean      @default(true)
  mergedIntoId String?
  mergedInto   Customer?    @relation("CustomerMerge", fields: [mergedIntoId], references: [id])
  mergedFrom   Customer[]   @relation("CustomerMerge")
  mergedAt     DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  prices        CustomerPrice[]
  salesOrders   SalesOrder[]
  payments      Payment[]
  creditEntries CustomerCreditEntry[]

  @@index([nameKey(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([pincode])
  @@index([type])
}

/// A negotiated price for one customer and variant; it wins over every list price.
model CustomerPrice {
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  variantId  String
  variant    Variant  @relation(fields: [variantId], references: [id])
  price      Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@id([customerId, variantId])
  @@index([variantId])
}

// ─── Sales ───────────────────────────────────────────────────────────────────

enum SalesOrderType {
  REGULAR
  PRE_ORDER
}

enum SalesChannel {
  STORE
  WEBSITE
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  WHOLESALE
  OTHER
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PACKED
  DISPATCHED
  DELIVERED
  COMPLETED
  CANCELLED
}

enum FulfilmentMethod {
  COUNTER
  DELIVERY
}

enum PriceSource {
  CUSTOMER
  TIER
  WHOLESALE
  OFFER
  REGULAR
  MANUAL
}

/// A sale or order. All amounts are GST-inclusive except the taxable totals.
/// Revenue is recognised at `fulfilledAt` (handover or dispatch) — never before,
/// so money taken earlier is an advance. Once past DRAFT the amounts are frozen
/// by a trigger; corrections are returns and refunds, never edits.
model SalesOrder {
  id              String           @id @default(uuid())
  /// SO-<financial year>-00001, e.g. SO-2627-00001 for FY 2026-27.
  code            String           @unique
  type            SalesOrderType   @default(REGULAR)
  channel         SalesChannel
  fulfilment      FulfilmentMethod
  status          SalesOrderStatus @default(DRAFT)
  /// Null for walk-in sales.
  customerId      String?
  customer        Customer?        @relation(fields: [customerId], references: [id])
  /// Name printed on the receipt, frozen at sale.
  customerName    String?
  locationId      String
  location        Location         @relation(fields: [locationId], references: [id])
  /// Wholesale price rules applied (wholesale customer or channel).
  wholesale       Boolean          @default(false)
  isInterState    Boolean          @default(false)
  orderDate       DateTime         @db.Date
  dueDate         DateTime?        @db.Date
  expectedArrival DateTime?        @db.Date
  subtotal        Decimal          @db.Decimal(14, 2)
  lineDiscounts   Decimal          @default(0) @db.Decimal(14, 2)
  orderDiscount   Decimal          @default(0) @db.Decimal(14, 2)
  shippingCharged Decimal          @default(0) @db.Decimal(14, 2)
  grandTotal      Decimal          @db.Decimal(14, 2)
  taxableTotal    Decimal          @db.Decimal(14, 2)
  gstTotal        Decimal          @db.Decimal(14, 2)
  externalRef     String?
  notes           String?
  /// Client-generated per POS checkout; a retry returns the same sale.
  idempotencyKey  String?          @unique
  confirmedAt     DateTime?
  fulfilledAt     DateTime?
  fulfilledDate   DateTime?        @db.Date
  cancelledAt     DateTime?
  cancelReason    String?
  stockDocumentId String?          @unique
  stockDocument   StockDocument?   @relation("SalesOrderStockDocument", fields: [stockDocumentId], references: [id])
  createdById     String?
  createdBy       User?            @relation(fields: [createdById], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  lines         SalesOrderLine[]
  events        SalesOrderEvent[]
  allocations   PaymentAllocation[]
  creditEntries CustomerCreditEntry[]
  returns       SalesReturn[]
  shipments     Shipment[]
  expenses      Expense[]

  @@index([status, orderDate])
  @@index([customerId])
  @@index([fulfilledDate])
  @@index([channel])
  @@index([type, status])
}

/// Price snapshot per item. `cogs` is fixed when the stock leaves (null until then).
model SalesOrderLine {
  id                 String      @id @default(uuid())
  orderId            String
  order              SalesOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId          String
  variant            Variant     @relation(fields: [variantId], references: [id])
  position           Int
  quantity           Int
  /// List regular price at the time of sale.
  regularPrice       Decimal     @db.Decimal(14, 2)
  /// Price per unit charged, before discounts.
  unitPrice          Decimal     @db.Decimal(14, 2)
  priceSource        PriceSource
  lineDiscount       Decimal     @default(0) @db.Decimal(14, 2)
  orderDiscountShare Decimal     @default(0) @db.Decimal(14, 2)
  lineTotal          Decimal     @db.Decimal(14, 2)
  gstRate            Decimal     @db.Decimal(5, 2)
  taxableValue       Decimal     @db.Decimal(14, 2)
  gstAmount          Decimal     @db.Decimal(14, 2)
  /// Cost of the units with a known cost, fixed at deduction.
  cogs               Decimal?    @db.Decimal(18, 6)
  /// Units that left with an unknown cost (excluded from margin, never guessed).
  unknownCostQty     Int         @default(0)

  reservations Reservation[]
  returnLines  SalesReturnLine[]

  @@unique([orderId, variantId])
  @@index([variantId])
}

/// Units held for a confirmed order line. Not a stock movement: physical stock
/// is unchanged and only "available" drops. Released (never deleted) when the
/// order is fulfilled or cancelled, or when a pre-order's allocation is undone;
/// a line can be allocated again later, but a trigger allows only one active
/// reservation per line at a time.
model Reservation {
  id            String         @id @default(uuid())
  orderLineId   String
  orderLine     SalesOrderLine @relation(fields: [orderLineId], references: [id])
  variantId     String
  variant       Variant        @relation(fields: [variantId], references: [id])
  locationId    String
  location      Location       @relation(fields: [locationId], references: [id])
  quantity      Int
  createdAt     DateTime       @default(now())
  releasedAt    DateTime?
  /// FULFILLED, CANCELLED or DEALLOCATED.
  releaseReason String?

  @@index([variantId, locationId, releasedAt])
  @@index([orderLineId])
}

/// Status history shown as the order timeline. Append-only.
model SalesOrderEvent {
  id          String            @id @default(uuid())
  orderId     String
  order       SalesOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  action      String
  status      SalesOrderStatus?
  note        String?
  createdById String?
  createdBy   User?             @relation(fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())

  @@index([orderId, createdAt])
}

// ─── Payments ────────────────────────────────────────────────────────────────

enum PaymentDirection {
  IN
  OUT
}

enum CreditEntryType {
  OVERPAYMENT
  APPLIED
  REFUNDED
  CANCELLED_ORDER
  RETURN
  REVERSAL
}

/// Money received (IN) or paid back (OUT), always a positive amount. Append-only:
/// a mistake is voided by a reversal row in the opposite direction, at most once.
/// What an order has been paid is derived from allocations, never stored.
model Payment {
  id           String           @id @default(uuid())
  code         String           @unique
  direction    PaymentDirection
  /// Copied from the account at the time, so reports survive account edits.
  method       PaymentMethod
  accountId    String
  account      ReceivingAccount @relation(fields: [accountId], references: [id])
  amount       Decimal          @db.Decimal(14, 2)
  /// Provider fee (gateway %) on money received; feeds contribution profit.
  fee          Decimal          @default(0) @db.Decimal(14, 2)
  reference    String?
  businessDate DateTime         @db.Date
  customerId   String?
  customer     Customer?        @relation(fields: [customerId], references: [id])
  notes        String?
  reversalOfId String?          @unique
  reversalOf   Payment?         @relation("PaymentReversal", fields: [reversalOfId], references: [id])
  reversedBy   Payment?         @relation("PaymentReversal")
  createdById  String?
  createdBy    User?            @relation(fields: [createdById], references: [id])
  createdAt    DateTime         @default(now())

  allocations   PaymentAllocation[]
  creditEntries CustomerCreditEntry[]
  salesReturn   SalesReturn?

  @@index([businessDate])
  @@index([customerId])
  @@index([accountId, businessDate])
}

/// Money applied to an order, from a payment or from the customer's credit.
/// Signed: positive pays the order, negative gives money back (refund, void).
/// The sum per order is what it has been paid. Append-only.
model PaymentAllocation {
  id            String               @id @default(uuid())
  orderId       String
  order         SalesOrder           @relation(fields: [orderId], references: [id])
  paymentId     String?
  payment       Payment?             @relation(fields: [paymentId], references: [id])
  creditEntryId String?              @unique
  creditEntry   CustomerCreditEntry? @relation(fields: [creditEntryId], references: [id])
  amount        Decimal              @db.Decimal(14, 2)
  createdAt     DateTime             @default(now())

  @@index([orderId])
  @@index([paymentId])
}

/// The customer's credit ledger: money held for them (overpayments, cancelled
/// orders) and its use or refund. Signed; the balance is the sum and can never
/// go below zero. Append-only.
model CustomerCreditEntry {
  id          String          @id @default(uuid())
  customerId  String
  customer    Customer        @relation(fields: [customerId], references: [id])
  type        CreditEntryType
  amount      Decimal         @db.Decimal(14, 2)
  paymentId   String?
  payment     Payment?        @relation(fields: [paymentId], references: [id])
  orderId     String?
  order       SalesOrder?     @relation(fields: [orderId], references: [id])
  note        String?
  createdById String?
  createdBy   User?           @relation(fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())

  allocation  PaymentAllocation?
  salesReturn SalesReturn?

  @@index([customerId, createdAt])
}

/// Money moved between the business's own accounts (cash to bank, personal
/// PhonePe to business). Never a sale or an expense. Append-only; reversed by a
/// mirror transfer.
model AccountTransfer {
  id            String           @id @default(uuid())
  code          String           @unique
  fromAccountId String
  fromAccount   ReceivingAccount @relation("TransferFrom", fields: [fromAccountId], references: [id])
  toAccountId   String
  toAccount     ReceivingAccount @relation("TransferTo", fields: [toAccountId], references: [id])
  amount        Decimal          @db.Decimal(14, 2)
  businessDate  DateTime         @db.Date
  reference     String?
  notes         String?
  reversalOfId  String?          @unique
  reversalOf    AccountTransfer? @relation("TransferReversal", fields: [reversalOfId], references: [id])
  reversedBy    AccountTransfer? @relation("TransferReversal")
  createdById   String?
  createdBy     User?            @relation(fields: [createdById], references: [id])
  createdAt     DateTime         @default(now())

  @@index([businessDate])
}

// ─── Returns ─────────────────────────────────────────────────────────────────

enum ReturnCondition {
  RESELLABLE
  DAMAGED
  WRITE_OFF
}

enum RefundMethod {
  NONE
  REFUND
  CREDIT
}

/// Goods coming back from a fulfilled order. Reverses that share of revenue and
/// GST; resellable and damaged units go back into stock at the cost they left
/// at, written-off units don't (their cost stays a loss). If the customer had
/// paid more than the order is now worth, the difference goes back as a refund
/// or as credit. The order's net value is its total minus its returns.
/// Append-only.
model SalesReturn {
  id              String               @id @default(uuid())
  code            String               @unique
  orderId         String
  order           SalesOrder           @relation(fields: [orderId], references: [id])
  locationId      String
  location        Location             @relation(fields: [locationId], references: [id])
  businessDate    DateTime             @db.Date
  reason          String
  /// GST-inclusive value reversed (lines plus any shipping refund).
  amount          Decimal              @db.Decimal(14, 2)
  taxableValue    Decimal              @db.Decimal(14, 2)
  gstAmount       Decimal              @db.Decimal(14, 2)
  shippingRefund  Decimal              @default(0) @db.Decimal(14, 2)
  refundMethod    RefundMethod
  refundAmount    Decimal              @default(0) @db.Decimal(14, 2)
  paymentId       String?              @unique
  payment         Payment?             @relation(fields: [paymentId], references: [id])
  creditEntryId   String?              @unique
  creditEntry     CustomerCreditEntry? @relation(fields: [creditEntryId], references: [id])
  stockDocumentId String?              @unique
  stockDocument   StockDocument?       @relation("SalesReturnStockDocument", fields: [stockDocumentId], references: [id])
  createdById     String?
  createdBy       User?                @relation(fields: [createdById], references: [id])
  createdAt       DateTime             @default(now())

  lines SalesReturnLine[]

  @@index([orderId])
  @@index([businessDate])
}

model SalesReturnLine {
  id             String          @id @default(uuid())
  returnId       String
  salesReturn    SalesReturn     @relation(fields: [returnId], references: [id])
  orderLineId    String
  orderLine      SalesOrderLine  @relation(fields: [orderLineId], references: [id])
  variantId      String
  variant        Variant         @relation(fields: [variantId], references: [id])
  quantity       Int
  condition      ReturnCondition
  amount         Decimal         @db.Decimal(14, 2)
  taxableValue   Decimal         @db.Decimal(14, 2)
  gstAmount      Decimal         @db.Decimal(14, 2)
  /// Cost of the returned units with a known cost, at what they were sold at.
  cogs           Decimal         @default(0) @db.Decimal(18, 6)
  unknownCostQty Int             @default(0)

  @@index([orderLineId])
}

// ─── Shipping ────────────────────────────────────────────────────────────────

enum ShipmentStatus {
  PENDING
  PACKED
  DISPATCHED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RTO
  RETURNED
  CANCELLED
}

/// A courier company. `trackingUrlTemplate` holds "{awb}" where the tracking
/// number goes; the CRM only links to the courier's page, it never polls it.
model CourierPartner {
  id                  String     @id @default(uuid())
  name                String
  nameKey             String     @unique
  trackingUrlTemplate String?
  phone               String?
  notes               String?
  isActive            Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  shipments           Shipment[]
}

/// Getting a delivery order to the customer. Its status, entered by hand from
/// the courier's tracking, drives the order: packed packs it, dispatched takes
/// the stock out (through the sales engine), delivered completes it. One open
/// shipment per order; a cancelled or returned one can be followed by a new one.
model Shipment {
  id           String          @id @default(uuid())
  code         String          @unique
  orderId      String
  order        SalesOrder      @relation(fields: [orderId], references: [id])
  courierId    String?
  courier      CourierPartner? @relation(fields: [courierId], references: [id])
  status       ShipmentStatus  @default(PENDING)
  /// What the courier charges us; compared with the shipping charged to the customer.
  courierCost  Decimal         @default(0) @db.Decimal(14, 2)
  notes        String?
  packedAt     DateTime?
  dispatchedAt DateTime?
  deliveredAt  DateTime?
  createdById  String?
  createdBy    User?           @relation(fields: [createdById], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  packages ShipmentPackage[]
  events   ShipmentEvent[]

  @@index([status])
  @@index([orderId])
}

/// One parcel with its own AWB; an order can go out in several.
model ShipmentPackage {
  id         String   @id @default(uuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id])
  /// Upper-case; unique, so the same tracking number can't be booked twice.
  awb        String   @unique
  weightKg   Decimal? @db.Decimal(10, 3)
  notes      String?
  createdAt  DateTime @default(now())
}

/// Status history of a shipment. Append-only.
model ShipmentEvent {
  id          String         @id @default(uuid())
  shipmentId  String
  shipment    Shipment       @relation(fields: [shipmentId], references: [id])
  status      ShipmentStatus
  note        String?
  createdById String?
  createdBy   User?          @relation(fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())

  @@index([shipmentId, createdAt])
}

// ─── Expenses & cash closing ─────────────────────────────────────────────────

model ExpenseCategory {
  id        String    @id @default(uuid())
  name      String
  nameKey   String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expenses  Expense[]
}

enum ExpenseKind {
  OPERATING
  ORDER
}

/// Money spent, from one of the business's accounts. Never a sale or a refund.
/// Append-only: a mistake is voided by a reversal row (at most once).
model Expense {
  id           String           @id @default(uuid())
  code         String           @unique
  categoryId   String
  category     ExpenseCategory  @relation(fields: [categoryId], references: [id])
  kind         ExpenseKind
  /// Set for ORDER expenses (packaging, extra courier for one order).
  orderId      String?
  order        SalesOrder?      @relation(fields: [orderId], references: [id])
  accountId    String
  account      ReceivingAccount @relation(fields: [accountId], references: [id])
  amount       Decimal          @db.Decimal(14, 2)
  businessDate DateTime         @db.Date
  vendor       String?
  reference    String?
  notes        String?
  reversalOfId String?          @unique
  reversalOf   Expense?         @relation("ExpenseReversal", fields: [reversalOfId], references: [id])
  reversedBy   Expense?         @relation("ExpenseReversal")
  createdById  String?
  createdBy    User?            @relation(fields: [createdById], references: [id])
  createdAt    DateTime         @default(now())

  @@index([businessDate])
  @@index([accountId, businessDate])
  @@index([orderId])
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

/// One cash drawer on one business day. Closing records the count against what
/// the ledger says should be there; the difference is recorded, never posted.
/// While CLOSED, nothing can be posted to that drawer on that date.
model CashSession {
  id             String            @id @default(uuid())
  accountId      String
  account        ReceivingAccount  @relation(fields: [accountId], references: [id])
  businessDate   DateTime          @db.Date
  status         CashSessionStatus @default(OPEN)
  openingAmount  Decimal           @db.Decimal(14, 2)
  expectedAmount Decimal?          @db.Decimal(14, 2)
  countedAmount  Decimal?          @db.Decimal(14, 2)
  discrepancy    Decimal?          @db.Decimal(14, 2)
  notes          String?
  openedById     String?
  openedBy       User?             @relation("CashOpenedBy", fields: [openedById], references: [id])
  openedAt       DateTime          @default(now())
  closedById     String?
  closedBy       User?             @relation("CashClosedBy", fields: [closedById], references: [id])
  closedAt       DateTime?
  updatedAt      DateTime          @updatedAt

  @@unique([accountId, businessDate])
  @@index([businessDate])
}

// ─── Stock counts ────────────────────────────────────────────────────────────

enum StockCountStatus {
  OPEN
  SUBMITTED
  APPROVED
  CANCELLED
  REVERSED
}

/// A physical count of sellable stock at one location. Each line keeps the
/// system quantity at the moment counting started, so the difference is what
/// the shelf showed against what the books said then. Approval posts one
/// ADJUSTMENT stock document for all differences; reversing the count reverses
/// that document. Never deleted.
model StockCount {
  id                   String           @id @default(uuid())
  code                 String           @unique
  locationId           String
  location             Location         @relation(fields: [locationId], references: [id])
  categoryId           String?
  category             Category?        @relation(fields: [categoryId], references: [id])
  blind                Boolean          @default(true)
  status               StockCountStatus @default(OPEN)
  notes                String?
  createdById          String?
  createdBy            User?            @relation("StockCountCreatedBy", fields: [createdById], references: [id])
  submittedById        String?
  submittedBy          User?            @relation("StockCountSubmittedBy", fields: [submittedById], references: [id])
  submittedAt          DateTime?
  approvedById         String?
  approvedBy           User?            @relation("StockCountApprovedBy", fields: [approvedById], references: [id])
  approvedAt           DateTime?
  adjustmentDocumentId String?          @unique
  adjustmentDocument   StockDocument?   @relation("StockCountAdjustment", fields: [adjustmentDocumentId], references: [id])
  cancelledAt          DateTime?
  cancelReason         String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  lines StockCountLine[]

  @@index([status])
  @@index([locationId])
}

model StockCountLine {
  id         String           @id @default(uuid())
  countId    String
  count      StockCount       @relation(fields: [countId], references: [id])
  variantId  String
  variant    Variant          @relation(fields: [variantId], references: [id])
  /// Sellable units at the location when counting started (or the line was added).
  systemQty  Int
  countedQty Int?
  reasonCode StockReasonCode?
  note       String?
  countedAt  DateTime?

  @@unique([countId, variantId])
}

// ─── Import & website sync ───────────────────────────────────────────────────

enum ImportKind {
  PRODUCTS
  OPENING_STOCK
  CUSTOMERS
}

enum ImportBatchStatus {
  /// Uploaded; columns not mapped yet.
  UPLOADED
  /// Mapped and checked; waiting for approval.
  VALIDATED
  IMPORTED
  ROLLED_BACK
  CANCELLED
}

enum ImportRowStatus {
  PENDING
  VALID
  ERROR
  /// Already in the CRM (or repeated earlier in the file); skipped, never overwritten.
  DUPLICATE
  IMPORTED
}

/// A saved column mapping (target field → file header) for a kind of import.
model ImportTemplate {
  id          String     @id @default(uuid())
  name        String
  kind        ImportKind
  mapping     Json
  createdById String?
  createdBy   User?      @relation(fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([kind, name])
}

/// One uploaded file going through map → check → approve, and possibly rollback.
/// Rows are kept so the batch history shows exactly what came in and what it created.
model ImportBatch {
  id              String            @id @default(uuid())
  code            String            @unique
  kind            ImportKind
  status          ImportBatchStatus @default(UPLOADED)
  fileName        String
  headers         Json
  mapping         Json?
  /// Opening stock lands in this location.
  locationId      String?
  location        Location?         @relation(fields: [locationId], references: [id])
  totalRows       Int
  validRows       Int               @default(0)
  errorRows       Int               @default(0)
  duplicateRows   Int               @default(0)
  importedRows    Int               @default(0)
  /// The opening-stock document an OPENING_STOCK batch posted.
  stockDocumentId String?           @unique
  createdById     String?
  createdBy       User?             @relation("ImportCreatedBy", fields: [createdById], references: [id])
  approvedById    String?
  approvedBy      User?             @relation("ImportApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rolledBackById  String?
  rolledBackBy    User?             @relation("ImportRolledBackBy", fields: [rolledBackById], references: [id])
  rolledBackAt    DateTime?
  rollbackReason  String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  rows            ImportRow[]

  @@index([kind, createdAt])
}

model ImportRow {
  id              String          @id @default(uuid())
  batchId         String
  batch           ImportBatch     @relation(fields: [batchId], references: [id])
  /// Line number in the file (header is row 1).
  rowNumber       Int
  raw             Json
  mapped          Json?
  status          ImportRowStatus @default(PENDING)
  errors          Json?
  duplicateOf     String?
  /// What approval created from this row (Product, Variant, Customer…).
  createdEntity   String?
  createdEntityId String?

  @@unique([batchId, rowNumber])
  @@index([batchId, status])
}

enum SyncSource {
  /// Built-in sample data for demos; never the real website.
  MOCK
  LIVE
}

enum SyncMode {
  DRY_RUN
  LINK_IDS
}

enum SyncRunStatus {
  SUCCEEDED
  FAILED
}

/// A read-only pull from the website. Dry runs only report; LINK_IDS writes
/// website ids onto matching CRM variants and nothing else. Nothing is ever
/// written to the website.
model SyncRun {
  id          String        @id @default(uuid())
  code        String        @unique
  source      SyncSource
  mode        SyncMode
  status      SyncRunStatus
  summary     Json?
  error       String?
  startedAt   DateTime      @default(now())
  finishedAt  DateTime?
  createdById String?
  createdBy   User?         @relation(fields: [createdById], references: [id])

  @@index([startedAt])
}
