NODE_ENV=development
PORT=8100
# Loopback only; nginx on the same host is the public entry point
HOST=127.0.0.1
# Same value as packages/crm-db/.env
CRM_DATABASE_URL=postgresql://crm:change-me@127.0.0.1:5433/littlestepz_crm?schema=public
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3100
# 32+ random characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
BCRYPT_ROUNDS=12
COOKIE_SECURE=false
TRUST_PROXY_HOPS=0
LOG_LEVEL=info

# Used only by `pnpm --filter crm-api seed`
SEED_ADMIN_NAME=Owner
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# true = also create sample cashier/ops logins (demo only)
SEED_DEMO_USERS=false

# Website sync (read-only; nothing is ever written to littlestepz.in).
# off  = not connected (default)
# mock = built-in SAMPLE data for demos; refused in production
# live = the website's GET-only export endpoints (docs/crm/WEBSITE_SYNC_CONTRACT.md)
WEBSITE_SYNC_MODE=off
WEBSITE_SYNC_URL=
WEBSITE_SYNC_KEY=

# Product photo uploads (Cloudinary). Leave blank to turn uploads off; photo links still work.
# The website's account can be reused: the CRM only uploads to, and deletes from, CLOUDINARY_FOLDER.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=littlestepz-crm
