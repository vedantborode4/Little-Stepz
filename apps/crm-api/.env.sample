NODE_ENV=development
PORT=8100
# Same value as packages/crm-db/.env
CRM_DATABASE_URL=postgresql://crm:change-me@127.0.0.1:5433/littlestepz_crm?schema=public
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3100
# 32+ random characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
BCRYPT_ROUNDS=12
COOKIE_SECURE=false
TRUST_PROXY_HOPS=0
LOG_LEVEL=info

# Used only by `pnpm --filter crm-api seed`
SEED_ADMIN_NAME=Owner
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# true = also create sample cashier/ops logins (demo only)
SEED_DEMO_USERS=false
