{
  "expo": {
    "name": "Little Stepz",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "littlestepz",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "in.littlestepz",
      "icon": "./assets/images/ios-icon.png",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "in.littlestepz",
      "scheme": "in.littlestepz",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Little Stepz needs access to your photos so you can add pictures to a product review or set your profile picture."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#FF383C"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/icon.png",
          "imageWidth": 140,
          "dark": {
            "backgroundColor": "#0B0B0F",
            "image": "./assets/images/icon.png",
            "imageWidth": 140
          },
          "android": {
            "backgroundColor": "#FFFFFF",
            "image": "./assets/images/icon.png",
            "imageWidth": 140,
            "dark": {
              "backgroundColor": "#0B0B0F",
              "image": "./assets/images/icon.png",
              "imageWidth": 140
            }
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6e4ada83-5b8f-47c0-8759-0855ece25bff"
      }
    },
    "owner": "vedantborode"
  }
}
