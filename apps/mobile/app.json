{
  "expo": {
    "name": "Little Stepz",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "littlestepz",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "in.littlestepz",
      "icon": "./assets/images/ios-icon-curve-2.png",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "in.littlestepz",
      "scheme": "in.littlestepz",
      "allowBackup": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "littlestepz.in",
              "pathPrefix": "/ref"
            },
            {
              "scheme": "https",
              "host": "littlestepz.in",
              "pathPrefix": "/pre-orders/pay"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E31E26",
        "foregroundImage": "./assets/images/android-icon-foreground-curve-2.png",
        "backgroundImage": "./assets/images/android-icon-background-curve-2.png",
        "monochromeImage": "./assets/images/android-icon-monochrome-curve-2.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Little Stepz needs access to your photos so you can add pictures to a product review or set your profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome-curve-2.png",
          "color": "#FF383C"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-curve-1.png",
          "imageWidth": 140,
          "dark": {
            "backgroundColor": "#0B0B0F",
            "image": "./assets/images/splash-curve-1.png",
            "imageWidth": 140
          },
          "android": {
            "backgroundColor": "#FFFFFF",
            "image": "./assets/images/splash-curve-1.png",
            "imageWidth": 140,
            "dark": {
              "backgroundColor": "#0B0B0F",
              "image": "./assets/images/splash-curve-1.png",
              "imageWidth": 140
            }
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6e4ada83-5b8f-47c0-8759-0855ece25bff"
      }
    },
    "owner": "vedantborode"
  }
}
