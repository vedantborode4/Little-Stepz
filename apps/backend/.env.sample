#  Server
PORT=8000
NODE_ENV=development

# Number of reverse proxies in front of this process (Render/Nginx/Cloudflare = usually 1).
# 0 = no proxy, use the socket address. Leave at 0 locally.
# Without this every IP-keyed rate limiter shares one bucket for the whole site.
# Never set this to `true` — that lets clients spoof X-Forwarded-For and bypass the limiters.
TRUST_PROXY_HOPS=0

#  Auth 
ACCESS_TOKEN_SECRET=your-access-token-secret-min-32-chars
ACCESS_TOKEN_EXPIRES=30m

SALT_ROUNDS=12

REFRESH_TOKEN_BYTES=64
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_SALT_ROUNDS=12

# Minutes a forgot-password code/link stays valid (default 15)
PASSWORD_RESET_TTL_MINUTES=15

#  Google Sign-in — comma-separated OAuth client IDs (web, iOS, Android, Expo)
GOOGLE_CLIENT_IDS=xxxx-web.apps.googleusercontent.com,yyyy-ios.apps.googleusercontent.com

#  Sign in with Apple — comma-separated audiences accepted in the identity token.
#  For native iOS sign-in this is the app's bundle identifier (NOT a Services ID).
#  Required by POST /auth/apple; leaving it unset disables only that endpoint.
APPLE_CLIENT_IDS=in.littlestepz

#  Razorpay 
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

#  Delhivery (B2C "One" API)
DELHIVERY_API_TOKEN=your-delhivery-api-token
# Registered warehouse/pickup name exactly as it appears in the Delhivery panel.
# Shipments reference the warehouse by NAME ONLY, so any mismatch (case, spacing, a
# warehouse that was never created) fails every manifest with
# "ClientWarehouse matching query does not exist". Check with
#   GET  /api/v1/admin/shipping/warehouse
# and register one with
#   POST /api/v1/admin/shipping/warehouse
# The backend also verifies this at boot and logs loudly if it doesn't resolve.
DELHIVERY_PICKUP_NAME=Primary
# Origin pincode used for shipping-rate lookups (your warehouse pincode)
DELHIVERY_ORIGIN_PINCODE=110001

#  Pickup warehouse details — only needed to REGISTER the warehouse via
#  POST /admin/shipping/warehouse. Warehouses are per-account and per-environment:
#  one created on staging does not exist in production.
DELHIVERY_WAREHOUSE_EMAIL=support@littlestepz.in
DELHIVERY_WAREHOUSE_PHONE=9999999999
DELHIVERY_WAREHOUSE_ADDRESS=Shop 1, Example Road
DELHIVERY_WAREHOUSE_CITY=Pune
DELHIVERY_WAREHOUSE_STATE=Maharashtra
# Defaults to DELHIVERY_ORIGIN_PINCODE when unset
DELHIVERY_WAREHOUSE_PIN=411001
# Optional: override the base URL (defaults to production https://track.delhivery.com)
# DELHIVERY_BASE_URL=https://track.delhivery.com
# Shared secret guarding POST /webhooks/delhivery (?token= or x-delhivery-token header)
DELHIVERY_WEBHOOK_TOKEN=your-delhivery-webhook-secret
# Flat shipping charge (INR) used when the rate API is unavailable
DELHIVERY_FALLBACK_SHIPPING=50

# Delivery is free for the customer and the business absorbs the carrier cost (default: true).
# Set to false to bill the customer again — but first make apps/web's CheckoutSummary read
# /checkout/calculate instead of computing `subtotal - discount` and hardcoding "Shipping: Free",
# or web will display a total lower than the amount charged.
FREE_SHIPPING=true

#  Package dimensions (cm) + weight in GRAMS — default for all products
DELHIVERY_PKG_LENGTH=20
DELHIVERY_PKG_BREADTH=15
DELHIVERY_PKG_HEIGHT=10
DELHIVERY_PKG_WEIGHT=500

#  Auto-manifest sweeper — hands CONFIRMED orders to Delhivery without an admin
#  pressing "Ship". In-process setInterval, so it does NOT run on serverless hosts.
AUTO_SHIP_ENABLED=true
# How often to sweep (ms)
AUTO_SHIP_INTERVAL_MS=60000
# Orders manifested per sweep
AUTO_SHIP_BATCH=25
# Grace period before manifesting, so a customer cancelling a just-confirmed order
# doesn't leave a booked waybill behind (ms)
AUTO_SHIP_DELAY_MS=300000
# Give up after this many failures and raise an admin notification instead
AUTO_SHIP_MAX_ATTEMPTS=3

#  Email signup OTP — the account row is only created once the code is redeemed.
#  RESEND_API_KEY is REQUIRED: without it no code can be delivered and no account can
#  be created. The backend logs a loud error at boot if it's missing.
SIGNUP_OTP_TTL_MINUTES=15
SIGNUP_OTP_RESEND_COOLDOWN_SECONDS=60
MAX_SIGNUP_OTP_SENDS=5

#  Auth sweeper — reaps expired PendingSignup + PasswordResetToken rows.
AUTH_SWEEP_ENABLED=true
AUTH_SWEEP_INTERVAL_MS=3600000

#  Phone verification (SMS) ─────────────────────────────────────────────────────
#  Provider-agnostic: `console` logs instead of sending, so the whole flow can be
#  exercised for free. A production instance left on `console` logs an error at first
#  use — it would otherwise answer 200 while silently sending nothing.
SMS_PROVIDER=console            # console | smsgatewayhub | msg91 | twilio

#  SMSGatewayHub (https://www.smsgatewayhub.com/api/mt/SendSMS)
#  Sent as channel=2 (transactional) + route=1. EntityId/dlttemplateid are the DLT
#  identifiers — without them the operator rejects transactional traffic.
SMSGATEWAYHUB_API_KEY=your-smsgatewayhub-api-key
SMSGATEWAYHUB_SENDER_ID=LSTEPZ          # approved 6-character header
SMSGATEWAYHUB_ENTITY_ID=your-dlt-entity-id   # PEID from the DLT portal
SMSGATEWAYHUB_TELEMARKETER_ID=              # optional, from the DLT portal
#  India DLT: transactional SMS needs a registered 6-char sender header AND a
#  pre-registered template. A body that doesn't match the template is dropped by the
#  operator WHILE THE API STILL RETURNS SUCCESS — so "the API said 200" is not proof
#  of delivery. The template text lives in utils/sms/templates.ts and must match
#  character-for-character.
SMS_TEMPLATE_ID_PHONE_OTP=your-dlt-template-id
#  The OTP body, which must match the registered template CHARACTER-FOR-CHARACTER.
#  Kept in env so the approved wording can be pasted in without a code change.
#  {code} and {minutes} map to the template's {#var#} slots, IN ORDER. A template with
#  only one variable (the usual case for OTP) simply uses {code} and no {minutes}.
SMS_TEMPLATE_PHONE_OTP={code} is your OTP for login verification. Do not share this OTP with anyone. - Rushanjan LLP
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=LSTEPZ
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
PHONE_OTP_TTL_MINUTES=10
PHONE_OTP_RESEND_COOLDOWN_SECONDS=60
MAX_PHONE_OTP_SENDS=3
#  Keys the OTP hash. A 6-digit code has only 10^6 preimages, so a plain hash is
#  reversible from a DB dump. Falls back to ACCESS_TOKEN_SECRET if unset.
OTP_HASH_SECRET=
#  Spend controls. These DB-backed caps are the real guard — the IP rate limiters are
#  in-memory and per-process, so they do nothing across restarts or instances.
MAX_SMS_PER_USER_DAY=10
MAX_SMS_CHALLENGES_USER_DAY=5
MAX_SMS_PER_PHONE_DAY=5
SMS_DAILY_GLOBAL_CAP=500
#  Leave FALSE until the customer base has converted: every address predating phone
#  verification has an unverified number, so enabling this blocks checkout for all of
#  them. New/edited addresses verify at save time, so the base converts on its own.
REQUIRE_VERIFIED_PHONE_AT_CHECKOUT=false

#  Where new-order alerts are emailed. Comma-separated; falls back to every ADMIN
#  account's email. Push only reaches admins who signed in to the mobile app.
ADMIN_ORDER_EMAIL=

#  Cash on Delivery has been withdrawn — COD_MAX_AMOUNT is no longer read.

FRONTEND_URL=https://yourdomain.com
MIN_WITHDRAWAL_AMOUNT=100

#  Cloudinary
CLOUDINARY_CLOUD_NAME=asdf
CLOUDINARY_API_KEY=asdf
CLOUDINARY_API_SECRET=asdf

#  Email (Resend) — password resets, pre-order and affiliate notifications.
#  EMAIL_FROM must be an address on a domain VERIFIED in Resend (DNS SPF/DKIM).
#  A gmail.com / outlook.com sender is rejected — Resend can only send from a
#  domain you control. Without a verified domain nothing is delivered, and because
#  sending is fail-soft the API still answers 200, so the customer silently gets
#  no reset code.
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=Little Stepz <Support@littlestepz.in>
#  Optional — where customer replies go, if not the From address.
# EMAIL_REPLY_TO=someone@example.com

#  Push notifications (Expo) — optional access token for the Expo Push API.
#  Leave blank to send unauthenticated (works, but recommended for production/FCM v1).
EXPO_ACCESS_TOKEN=

#  Pre-Order
PREORDER_BALANCE_DAYS=7

#  Stock holds
#  Stock is decremented when the order is created, so an unpaid order holds real
#  units. This is how long it may hold them before the sweeper takes them back.
PENDING_ORDER_TTL_MIN=10
#  How often the sweeper runs, and how many stale orders it releases per pass.
STOCK_SWEEP_INTERVAL_MS=60000
STOCK_SWEEP_BATCH=100
#  Set to false to stop the sweeper without a redeploy (rollback lever).
STOCK_SWEEP_ENABLED=true

#production with no SSL
NODE_ENV=production
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

#production with SSL
NODE_ENV=production
COOKIE_SECURE=true
COOKIE_SAMESITE=strict

#dev
NODE_ENV=development
# COOKIE_SECURE not set → defaults to false