NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxx-web.apps.googleusercontent.com

# Server-side catalogue reads (sitemap, llms.txt, product/category metadata).
# Falls back to NEXT_PUBLIC_API_URL when unset.
API_URL=http://localhost:8000/api/v1

# Canonical origin — drives metadataBase, canonicals, sitemap and JSON-LD URLs.
NEXT_PUBLIC_SITE_URL=https://littlestepz.in

# Google Analytics 4. Unset it to disable tracking (e.g. local dev);
# point it at a test property for preview builds.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-EWT0G2CD9X

# Google Tag Manager container. Unset it to disable GTM (e.g. local dev).
# Do NOT also configure a GA4 tag inside GTM — GA4 is loaded directly above.
NEXT_PUBLIC_GTM_ID=GTM-WQ7N8723

# tawk.to live chat (public embed IDs — safe to expose). From the embed snippet:
# https://embed.tawk.to/<PROPERTY_ID>/<WIDGET_ID>  (Administration → Channels → Chat Widget)
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=
